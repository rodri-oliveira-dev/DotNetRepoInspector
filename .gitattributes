# Normalize text files and keep CI/container-friendly line endings.
* text=auto

# .NET and repository configuration
*.cs            text eol=lf
*.csproj        text eol=lf
*.fsproj        text eol=lf
*.vbproj        text eol=lf
*.props         text eol=lf
*.targets       text eol=lf
*.sln           text eol=lf
*.slnx          text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
*.toml          text eol=lf
*.editorconfig  text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf

# Scripts
*.sh            text eol=lf
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary assets
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
