{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DotNetRepoInspector inspection schema 1.6",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "dotNetSdk",
    "projects",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.6"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "dotNetSdk": {
      "$ref": "#/$defs/dotNetSdk"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "policyFindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policyFinding"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/integrationFinding"
      }
    },
    "integrationDiscovery": {
      "$ref": "#/$defs/integrationDiscovery"
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "commitSha": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "remoteUrl": {
          "type": "string"
        },
        "isDirty": {
          "type": "boolean"
        }
      }
    },
    "configuredSdk": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "rollForward": {
          "type": "string"
        },
        "allowPrerelease": {
          "type": "boolean"
        }
      }
    },
    "dotNetSdk": {
      "type": "object",
      "properties": {
        "globalJsonPath": {
          "type": "string"
        },
        "configured": {
          "$ref": "#/$defs/configuredSdk"
        },
        "resolvedVersion": {
          "type": "string"
        }
      }
    },
    "projectSdk": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "kind",
        "signals"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtype": {
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "enum": [
            "configuration",
            "request"
          ]
        },
        "automaticKind": {
          "type": "string"
        }
      }
    },
    "projectReference": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^DRI[0-9]{4}$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "path",
        "sdks",
        "targetFrameworks",
        "runtimeIdentifiers",
        "references",
        "diagnostics"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "resolvedSdkVersion": {
          "type": "string"
        },
        "sdks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectSdk"
          }
        },
        "targetFrameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputType": {
          "type": "string"
        },
        "isTestProject": {
          "type": "boolean"
        },
        "isPackable": {
          "type": "boolean"
        },
        "runtimeIdentifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectReference"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "policyScope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "project"
          ]
        },
        "projectPath": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "repository"
            }
          },
          "not": {
            "required": [
              "projectPath"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "project"
            }
          },
          "required": [
            "projectPath"
          ]
        }
      ]
    },
    "policyFinding": {
      "type": "object",
      "required": [
        "ruleCode",
        "severity",
        "message",
        "scope"
      ],
      "properties": {
        "ruleCode": {
          "type": "string",
          "pattern": "^DRP[0-9]{4}$"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/policyScope"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "integrationDiscovery": {
      "type": "object",
      "required": [
        "enabled",
        "completed",
        "truncated"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      }
    },
    "integrationSource": {
      "type": "object",
      "required": [
        "path",
        "line"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "integrationFinding": {
      "type": "object",
      "required": [
        "id",
        "projectPath",
        "kind",
        "direction",
        "technology",
        "source",
        "confidence",
        "signals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^integration-[0-9a-f]{16}$"
        },
        "projectPath": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": ["http", "messaging", "database", "cache", "storage", "rpc", "unknown"]
        },
        "direction": {
          "enum": ["outbound", "publish", "consume", "read", "write", "bidirectional", "unknown"]
        },
        "technology": {
          "type": "string",
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "pattern": "\\S"
        },
        "resourceType": {
          "type": "string",
          "pattern": "\\S"
        },
        "configurationKey": {
          "type": "string",
          "pattern": "\\S"
        },
        "contract": {
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/integrationSource"
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
