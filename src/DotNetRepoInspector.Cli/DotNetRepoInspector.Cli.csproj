<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotNetRepoInspector.Cli</RootNamespace>
    <AssemblyName>DotNetRepoInspector.Cli</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-repo-inspect</ToolCommandName>
    <PackageId>DotNetRepoInspector</PackageId>
    <Title>DotNetRepoInspector - .NET Repository Inspector</Title>
    <Authors>Rodrigo de Oliveira</Authors>
    <Description>CLI and .NET Tool for deterministic inspection and classification of .NET repositories using evaluated MSBuild metadata. Extract project types, target frameworks, SDKs, references, Git metadata, and architecture facts for CI/CD, automation, repository inventory, and technical governance.</Description>
    <PackageTags>dotnet;dotnet-tool;cli;msbuild;repository;repository-inspection;project-metadata;project-classification;architecture;architecture-governance;ci-cd;devops;automation;github-actions</PackageTags>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/DotNetRepoInspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rodri-oliveira-dev/DotNetRepoInspector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- DotNetRepoInspector is distributed as one tool package. Include the runtime
         outputs of internal ProjectReferences instead of declaring unpublished
         DotNetRepoInspector.* projects as NuGet package dependencies. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyToolRuntimeDependencies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetRepoInspector.Core/DotNetRepoInspector.Core.csproj" />
    <ProjectReference Include="../DotNetRepoInspector.Engine/DotNetRepoInspector.Engine.csproj" />
    <ProjectReference Include="../DotNetRepoInspector.Persistence/DotNetRepoInspector.Persistence.csproj" />
    <ProjectReference Include="../DotNetRepoInspector.Persistence.Http/DotNetRepoInspector.Persistence.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../resource/nuget-icon.png" Pack="true" PackagePath="/" Link="nuget-icon.png" />
  </ItemGroup>

  <Target Name="CopyToolRuntimeDependencies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage
        Include="@(ReferenceCopyLocalPaths)"
        TargetPath="%(ReferenceCopyLocalPaths.DestinationSubPath)" />
    </ItemGroup>
  </Target>
</Project>
